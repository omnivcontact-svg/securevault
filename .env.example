SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///vault.db

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=replace-with-fernet-key

# SMTP for password-reset OTP emails. Leave blank for local development OTP display.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# WebAuthn / Windows Hello / fingerprint / Face ID / platform passkey.
# Always open the app at http://localhost:5000 while developing.
WEBAUTHN_RP_NAME=SecureVault
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000
